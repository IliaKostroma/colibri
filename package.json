{
  "name": "colibri",
  "version": "1.0.0",
  "description": "Task management app with voice transcription and AI-powered text processing",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "start": "vite --port 5173 --strictPort --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.voicetranscriber.app",
    "productName": "COLIBRI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Это приложение использует микрофон для распознавания речи"
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12",
    "fast-check": "^3.19.0",
    "jsdom": "^24.1.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "voice",
    "transcription",
    "speech-to-text",
    "openai",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "express": "^5.2.1"
  }
}
